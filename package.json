{
  "name": "darkys-launcher",
  "email": "darkyslauncheroffical@gmail.com",
  "version": "1.4.1",
  "description": "Darkys Minecraft Launcher",
  "main": "main.js",
  "author": "DarkBlockWizard",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:win",
    "build:win:dir": "electron-builder --win dir --x64",
    "build:win": "electron-builder --win portable --x64",
    "build:linux": "electron-builder --linux deb rpm --x64",
    "build:mac": "electron-builder --mac dmg zip --universal",
    "test": "node --test",
    "test:pack": "node --test scripts/test-pack-archive.cjs"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "minecraft-launcher-core": "^3.18.1",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.darkys.launcher",
    "productName": "Darkys Launcher",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release-single"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/**/*"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "signAndEditExecutable": false,
      "executableName": "Darkys",
      "icon": "src/assets/logo.ico",
      "artifactName": "Darkys.exe",
      "target": [
        "portable"
      ]
    },
    "linux": {
      "icon": "src/assets/logo.png",
      "category": "Game",
      "target": [
        "deb",
        "rpm"
      ]
    },
    "mac": {
      "icon": "src/assets/logo.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Darkys Launcher"
    }
  }
}
